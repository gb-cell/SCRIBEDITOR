# --- OpenAI (serveur uniquement, jamais exposé au navigateur) ---
OPENAI_API_KEY=sk-...
MODEL=gpt-4o

# --- Auth.js / Google (obligatoire en production Vercel) ---
# Générer un secret : openssl rand -base64 32
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# URL publique de l'app (ex. https://scribeditor.vercel.app)
# En local : http://localhost:3000
AUTH_URL=http://localhost:3000

# --- Local uniquement ---
# true = pas de login Google (dev local). Jamais sur Vercel / prod.
AUTH_DISABLED=true
